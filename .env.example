# Copy to .env for local runs. Never commit .env.
# Without DATABASE_URL the app runs on embedded PGlite (dev only). As soon as
# DATABASE_URL is set (or NODE_ENV=production) the server REFUSES to start
# without BETTER_AUTH_SECRET and an https BETTER_AUTH_URL. There is no fallback.
DATABASE_URL=
# 32+ random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public base URL, e.g. https://baad-marib.onrender.com (empty locally = http://localhost:8080)
BETTER_AUTH_URL=
# Comma-separated admin (ديوان) addresses. Access ALSO needs emailVerified = true
# on that account. Sign-up does not verify email yet, so after the owner signs up
# DevOps runs the one line in docs/deploy.md ("Owner verification").
ADMIN_EMAIL=
# Proxies in front of the app that append to X-Forwarded-For. Render = 1.
# Only used when CF-Connecting-IP is missing. See src/lib/auth/client-ip.ts.
TRUST_PROXY_HOPS=1
# Tests only: a throwaway local Postgres for `npm run test:pg`, e.g.
# postgres://baad:baad@127.0.0.1:5432/baad_test
TEST_PG_URL=
