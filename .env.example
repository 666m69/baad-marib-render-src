# Copy to .env for local runs. Never commit .env.
# Without DATABASE_URL the app runs on embedded PGLite (dev only; production needs Postgres).
DATABASE_URL=
# 32+ random bytes, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public base URL, e.g. http://localhost:8080
BETTER_AUTH_URL=
# Comma-separated admin (ديوان) addresses. Access needs a verified email on that
# account: the email sign-up does not verify, so DevOps marks the owner's account
# verified once (update "user" set "emailVerified" = true where email = '…').
ADMIN_EMAIL=
# Render only: build the Node server instead of the Vercel output.
NITRO_PRESET=
