# Environment template for baad-marib

# Frontend toggle for auth
# Set to "true" only when auth is enabled in production.
VITE_AUTH_ENABLED=false

# Database connection for production deployments.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Better Auth secret used in production.
BETTER_AUTH_SECRET=

# Public base URL of the app.
# Example: https://your-app.vercel.app
BETTER_AUTH_URL=

# OAuth broker configuration. Leave empty if auth is disabled.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
